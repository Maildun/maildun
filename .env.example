# =============================================================================
# Application — set these first
# =============================================================================

# APP_KEY and APP_URL must be set correctly and kept stable in production.
APP_NAME=Maildun
APP_ENV=local
APP_KEY=
# Keys APP_KEY held previously, comma separated. Laravel falls back to these when
# decrypting, so workspace provider credentials survive a key rotation. Remove a
# key only once everything encrypted under it has been re-encrypted.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
# The canonical origin, and more load-bearing than it looks. Queue workers serve no
# request, so signed open, click, and unsubscribe links are built from this value,
# and its host is also the passkey relying party ID. Changing it invalidates every
# registered passkey and every signed link already sitting in an inbox.
APP_URL=http://localhost:8000
APP_VERSION=0.1.0-beta

# Check the official release manifest once daily. Set to false to disable it.
APP_UPDATE_CHECK_ENABLED=true
APP_UPDATE_MANIFEST_URL=https://raw.githubusercontent.com/Maildun/maildun/main/release-manifest.json

# Where the "Powered by Maildun" notice links. Leave this alone when running an
# unmodified copy. If you modify Maildun and let anyone else use it over a
# network, point this at your own complete corresponding source: the additional
# terms in LICENSE and section 13 of the AGPL both require it.
APP_SOURCE_URL=https://github.com/Maildun/maildun

# Comma separated proxy addresses, or "*" for a load balancer without a stable address.
# Leave empty when the app is served directly, or clients can spoof their own IP.
TRUSTED_PROXIES=

# Set to false for an invitation-only instance. The register routes stay in
# place either way, so this can be flipped without rebuilding the frontend, and
# people holding a workspace invitation can always finish signing up.
REGISTRATION_ENABLED=true

# Derives the WebAuthn user handle. Defaults to APP_KEY, which ties every passkey
# to it: rotating APP_KEY then locks people out of passkey sign-in. Set this to its
# own value, generated once and kept stable, to decouple the two.
PASSKEYS_USER_HANDLE_SECRET=

# OAuth clients may redirect only to these origins after authorization. Keep
# this list narrow; add localhost explicitly only while testing a local client.
MCP_REDIRECT_DOMAINS=https://chatgpt.com,https://grok.com
MCP_ACCESS_TOKEN_EXPIRATION_MINUTES=60
MCP_REFRESH_TOKEN_EXPIRATION_DAYS=30

# =============================================================================
# Application defaults
# =============================================================================

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# =============================================================================
# Logging
# =============================================================================

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# =============================================================================
# Database — choose SQLite, PostgreSQL, MySQL, or MariaDB
# =============================================================================

# SQLite needs no server and is the default. For PostgreSQL use "pgsql" on port
# 5432, for MySQL or MariaDB use "mysql"/"mariadb" on port 3306, then uncomment
# the connection details below.
DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=maildun
# DB_USERNAME=
# DB_PASSWORD=

# =============================================================================
# Sessions, cache, queues, and Redis
# =============================================================================

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=90

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =============================================================================
# Platform mail — required for password resets and other system notifications
# =============================================================================

# Choose exactly one transport: "smtp" or "ses". The example defaults to a
# local SMTP catcher. Workspace campaign/transactional providers are configured
# separately in Settings -> Email delivery and do not control system mail.
MAIL_MAILER=smtp
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP only — required when MAIL_MAILER=smtp.
# MAIL_SCHEME may stay null unless the provider explicitly requires "smtps".
# Replace every example value before deploying.
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null

# Amazon SES only — required when MAIL_MAILER=ses.
# The From address (or its domain) must be verified in MAIL_SES_REGION. These
# credentials intentionally do not reuse the AWS_* object-storage credentials.
MAIL_SES_KEY=
MAIL_SES_SECRET=
MAIL_SES_REGION=us-east-1
# Optional SES feedback/event settings.
MAIL_SES_CONFIGURATION_SET=
MAIL_SES_SNS_TOPIC_ARN=

# =============================================================================
# Workspace email delivery, tracking, and queues
# =============================================================================

# Set this to true only in local development to let workspace SMTP connections
# use localhost, 127.0.0.1, or ::1 (for example, a local Mailpit instance).
MAIL_ALLOW_LOCAL_SMTP_HOSTS=false

# Outbound send rate, shared by campaigns and transactional email. 0 disables
# the limit. A new Amazon SES account starts at 14 messages per second.
MAIL_RATE_LIMIT_PER_SECOND=0
# Seconds a send job waits before asking for a rate-limit slot again.
MAIL_RATE_LIMIT_RELEASE_AFTER=5
# Dedicated queues so a large campaign cannot starve tracking or transactional mail.
# Horizon picks these up from config/horizon.php automatically. If you run bare
# workers instead, they must name the queues, or nothing will send:
#   php artisan queue:work --queue=tracking,transactional,campaigns,default
# Point all three at "default" to run a single worker pool.
MAIL_TRACKING_QUEUE=tracking
MAIL_CAMPAIGN_QUEUE=campaigns
MAIL_TRANSACTIONAL_QUEUE=transactional
# Minutes a delivery may sit still before emails:resume sweeps it.
MAIL_STALLED_AFTER_MINUTES=15
# Minutes before an unprocessed durable event is safe to re-dispatch.
MAIL_TRACKING_REDISPATCH_AFTER_MINUTES=5
# Optional local DB-IP Lite MMDB enrichment. Files are never committed.
MAIL_TRACKING_GEOLOCATION_ENABLED=true
MAIL_TRACKING_CITY_DATABASE=
MAIL_TRACKING_ASN_DATABASE=
# Processed event payloads expire while campaign insight aggregates remain.
# Set to 0 to disable automatic pruning.
MAIL_TRACKING_EVENT_RETENTION_DAYS=90
MAIL_TRACKING_PRUNE_BATCH_SIZE=1000

# =============================================================================
# Horizon
# =============================================================================

# Horizon consumes Redis queues and should be kept alive by the deployment's
# process manager. These caps can be raised independently as traffic grows.
HORIZON_DEFAULT_MAX_PROCESSES=6
HORIZON_TRACKING_MAX_PROCESSES=4
HORIZON_TRANSACTIONAL_MAX_PROCESSES=6
HORIZON_CAMPAIGN_MAX_PROCESSES=10
HORIZON_DEFAULT_WAIT_SECONDS=60
HORIZON_TRACKING_WAIT_SECONDS=15
HORIZON_TRANSACTIONAL_WAIT_SECONDS=30
HORIZON_CAMPAIGN_WAIT_SECONDS=120
# 288 snapshots at five-minute intervals retain 24 hours of queue metrics.
HORIZON_METRICS_SNAPSHOTS=288
# Comma-separated accounts allowed to open /horizon outside local development.
HORIZON_ALLOWED_EMAILS=
# Receives Horizon long-wait notifications. Leave empty to disable email alerts.
HORIZON_NOTIFICATION_EMAIL=

# =============================================================================
# File storage — choose local or S3-compatible storage
# =============================================================================

# Choose "local" for files on this server or "s3" for AWS S3, Cloudflare R2,
# MinIO, DigitalOcean Spaces, or another compatible service. Local storage needs
# none of the AWS_* or R2_* values below. Use `php artisan storage:configure` to
# configure and verify a backend interactively.
FILESYSTEM_DISK=local

# Required only when FILESYSTEM_DISK=s3. Choose "aws", "r2", or "custom".
# "custom" uses the AWS_* block plus AWS_ENDPOINT.
OBJECT_STORAGE_PROVIDER=aws

# AWS S3 or custom S3-compatible storage — used when the provider is aws/custom.
# Bucket values are names, not URLs. The app separates private uploads from
# publicly served assets, so both bucket values are required.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
# Base URL for private-disk files. Leave empty for AWS S3, which builds its own.
# Set it for MinIO or any endpoint whose URLs are not AWS-shaped.
AWS_URL=
AWS_PUBLIC_BUCKET=
# Optional public CDN or custom-domain base URL, without a trailing slash.
AWS_PUBLIC_URL=
# Leave empty for AWS S3. Set only for another AWS-compatible endpoint.
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 only — used when OBJECT_STORAGE_PROVIDER=r2.
# Bucket values are names, not URLs. R2_ENDPOINT is the S3 API endpoint.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_DEFAULT_REGION=auto
R2_BUCKET=
R2_URL=
R2_PUBLIC_BUCKET=
# Public custom-domain base URL, without a trailing slash.
R2_PUBLIC_URL=
# Example: https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ENDPOINT=
R2_USE_PATH_STYLE_ENDPOINT=false

# =============================================================================
# Frontend build
# =============================================================================

VITE_APP_NAME="${APP_NAME}"

# Defaults to the public Hugeicons Stroke Rounded pack. Licensed deployments
# may select one of the Pro styles configured in vite.config.ts.
HUGEICONS_ICON_STYLE=free-stroke-rounded
