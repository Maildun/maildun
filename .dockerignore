# Build context exclusions. Everything the image needs is either committed
# source or produced inside the build, so local state stays out.

.git
.gitattributes
.gitignore

# Local environment and secrets. The image never bakes these in.
.env
.env.*
!.env.example
auth.json
*.pem
*.p12
*.pfx

# Installed by the build itself.
node_modules
vendor
public/build
public/hot
public/storage
bootstrap/ssr

# Generated by wayfinder during the asset build.
resources/js/actions
resources/js/routes
resources/js/wayfinder

# Runtime state that must come from a volume, never from the context.
storage/app
storage/framework/cache
storage/framework/sessions
storage/framework/views
storage/logs
storage/pail
storage/*.key
database/*.sqlite
*.mmdb

# Tooling and docs that do not affect the runtime image.
.agents
.ai
.claude
.codex
.cursor
.github
.grok
.migration
.idea
.vscode
.zed
.fleet
.nova
.phpunit.cache
.phpunit.result.cache
tests
docs
*.md
!README.md
Dockerfile
docker-compose.yml
.dockerignore
